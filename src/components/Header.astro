---
const base = import.meta.env.BASE_URL;
---

<header class="site-header" aria-label="Primary navigation">
  <a class="logo-link" href={base} aria-label="Julian Munoz home">
    <img class="logo" src={`${base}assets/jm-logo.svg`} alt="JM" width="32" height="32" />
  </a>

  <div class="header-actions">
    <div class="local-times" aria-label="Local times">
      <time class="local-time" datetime="00:00" data-time-zone="America/Bogota" aria-label="Bogotá local time">
        <span>BOG</span>
        <span class="clock-value">
          <span data-clock-hours>00</span><span class="clock-separator" aria-hidden="true">:</span><span data-clock-minutes>00</span>
        </span>
        <span data-clock-period>PM</span>
      </time>
      <time class="local-time is-hidden" datetime="00:00" data-time-zone="America/New_York" aria-label="New York local time" hidden>
        <span>NY</span>
        <span class="clock-value">
          <span data-clock-hours>00</span><span class="clock-separator" aria-hidden="true">:</span><span data-clock-minutes>00</span>
        </span>
        <span data-clock-period>PM</span>
      </time>
      <time class="local-time is-hidden" datetime="00:00" data-time-zone="Europe/London" aria-label="London local time" hidden>
        <span>LDN</span>
        <span class="clock-value">
          <span data-clock-hours>00</span><span class="clock-separator" aria-hidden="true">:</span><span data-clock-minutes>00</span>
        </span>
        <span data-clock-period>PM</span>
      </time>
    </div>
    <a class="icon-button contact-button" href="mailto:hello@julian-munoz.com" aria-label="Get in touch">
      <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" fill="currentColor" />
      </svg>
    </a>
    <button class="icon-button theme-button" type="button" aria-label="Change color theme">
      <svg class="theme-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 3C7.03 3 3 6.58 3 11c0 3.87 3.13 7 7 7h1.5c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.27-.39-.62-.39-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-3.87-4.03-7-9-7ZM7.5 11C6.67 11 6 10.33 6 9.5S6.67 8 7.5 8 9 8.67 9 9.5 8.33 11 7.5 11Zm2-3C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5 11 5.67 11 6.5 10.33 8 9.5 8Zm4.5 0c-.83 0-1.5-.67-1.5-1.5S13.17 5 14 5s1.5.67 1.5 1.5S14.83 8 14 8Zm3 3c-.83 0-1.5-.67-1.5-1.5S16.67 8 17.5 8s1.5.67 1.5 1.5S18.33 11 17.5 11Z" fill="currentColor" />
      </svg>
    </button>
  </div>
</header>
