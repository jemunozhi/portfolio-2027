---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Julian Munoz — Designer',
  description = 'Julian Munoz — designer shaping systems, strategy, quality and value of what gets built.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
